@echo off
echo Creating Python Virtual Environment...
python -m venv .venv
echo Upgrading pip...
.\.venv\Scripts\python.exe -m pip install --upgrade pip
echo Installing PyTorch...
.\.venv\Scripts\python.exe -m pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu
echo Installing other dependencies...
.\.venv\Scripts\python.exe -m pip install torch_geometric pandas numpy scikit-learn networkx scipy
echo Setup Complete! You can now run the experiment using run_experiment.bat
pause
